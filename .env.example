# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Only needed for the P0 probe's historical GTFS lookup (G3). Either one is enough.

# Mobility Database (https://mobilitydatabase.org): sign in, then copy the refresh token
# from your account page. The probe exchanges it for a short-lived access token.
MOBILITY_DB_REFRESH_TOKEN=

# Transitland (https://www.transit.land): sign up for the free API plan, then copy the API key.
TRANSITLAND_API_KEY=
